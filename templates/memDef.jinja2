---
brief: True
details: True
implements: True
url_source: True
---

{# Custom memDef template that renders each member as a collapsible
   admonition using the CSS classes defined in docs/static/doxide.css
   (variable, function, concept, define, typedef, enum). #}

{%- set kind = node.kind.value -%}
{%- set known_kinds = ['variable', 'function', 'concept', 'define', 'typedef', 'enum'] -%}
{%- if kind in known_kinds -%}
  {%- set css_kind = kind -%}
{%- elif kind in ['signal', 'slot', 'friend'] -%}
  {%- set css_kind = 'function' -%}
{%- elif kind == 'property' -%}
  {%- set css_kind = 'variable' -%}
{%- else -%}
  {%- set css_kind = 'function' -%}
{%- endif -%}
{%- set title_name = node.name_long if node.is_group else node.name_short -%}

{% filter indent(config.get('indent_level', 0), True) %}
???+ {{css_kind}} "{{title_name}}{{node.overload_suffix}}"

{% filter indent(4, True) %}
{% if configMemDef.get('brief') and node.has_brief -%}
{{node.brief}}
{% endif %}

{{node.codeblock | use_code_language(node.code_language)}}

{% if configMemDef.get('details') and node.has_details -%}
{{node.details | use_code_language(node.code_language)}}
{%- endif %}

{% if configMemDef.get('implements') and node.reimplements -%}
Implements [*{{node.reimplements.name_long}}*]({{node.reimplements.url}})
{%- endif %}
{% endfilter %}

{% endfilter %}
